generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SchoolType {
  TH
  THCS
  THPT
  OTHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum UserRole {
  SCHOOL_ADMIN
  TEACHER
  STUDENT
}

enum AcademicEntityStatus {
  ACTIVE
  INACTIVE
}

model School {
  id         String       @id @default(uuid()) @db.Uuid
  code       String       @unique @db.VarChar(50)
  name       String       @db.VarChar(255)
  shortName  String?      @map("short_name") @db.VarChar(100)
  schoolType SchoolType?  @map("school_type")
  email      String?      @db.VarChar(255)
  phone      String?      @db.VarChar(20)
  address    String?      @db.Text
  status     SchoolStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  users              User[]
  academicYears      AcademicYear[]
  semesters          Semester[]
  gradeLevels        GradeLevel[]
  subjects           Subject[]
  gradeLevelSubjects GradeLevelSubject[]
  homeroomClasses    HomeroomClass[]
  courseSections     CourseSection[]

  @@index([status])
  @@map("schools")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  schoolId     String     @map("school_id") @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  fullName     String     @map("full_name") @db.VarChar(255)
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  homeroomClasses HomeroomClass[] @relation("HomeroomTeacher")

  @@index([schoolId])
  @@index([status])
  @@index([role])
  @@map("users")
}

model AcademicYear {
  id        String               @id @default(uuid()) @db.Uuid
  schoolId  String               @map("school_id") @db.Uuid
  name      String               @db.VarChar(100)
  code      String               @db.VarChar(20)
  startDate DateTime             @map("start_date") @db.Date
  endDate   DateTime             @map("end_date") @db.Date
  isCurrent Boolean              @default(false) @map("is_current")
  status    AcademicEntityStatus @default(ACTIVE)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  semesters        Semester[]
  homeroomClasses  HomeroomClass[]
  courseSections   CourseSection[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([isCurrent])
  @@index([status])
  @@map("academic_years")
}

model Semester {
  id             String               @id @default(uuid()) @db.Uuid
  schoolId       String               @map("school_id") @db.Uuid
  academicYearId String               @map("academic_year_id") @db.Uuid
  name           String               @db.VarChar(50)
  code           String               @db.VarChar(20)
  startDate      DateTime             @map("start_date") @db.Date
  endDate        DateTime             @map("end_date") @db.Date
  isCurrent      Boolean              @default(false) @map("is_current")
  status         AcademicEntityStatus @default(ACTIVE)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, code])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([isCurrent])
  @@map("semesters")
}

model GradeLevel {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  name     String @db.VarChar(100)
  code     String @db.VarChar(20)

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevelSubjects GradeLevelSubject[]
  homeroomClasses    HomeroomClass[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("grade_levels")
}

model Subject {
  id          String               @id @default(uuid()) @db.Uuid
  schoolId    String               @map("school_id") @db.Uuid
  code        String               @db.VarChar(20)
  name        String               @db.VarChar(255)
  description String?              @db.Text
  status      AcademicEntityStatus @default(ACTIVE)

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevelSubjects GradeLevelSubject[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([status])
  @@map("subjects")
}

model GradeLevelSubject {
  id           String               @id @default(uuid()) @db.Uuid
  schoolId     String               @map("school_id") @db.Uuid
  gradeLevelId String               @map("grade_level_id") @db.Uuid
  subjectId    String               @map("subject_id") @db.Uuid
  isRequired   Boolean              @default(true) @map("is_required")
  status       AcademicEntityStatus @default(ACTIVE)

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevel     GradeLevel      @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  subject        Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  courseSections CourseSection[]

  @@unique([schoolId, gradeLevelId, subjectId])
  @@index([schoolId])
  @@index([gradeLevelId])
  @@index([subjectId])
  @@map("grade_level_subjects")
}

model HomeroomClass {
  id                String               @id @default(uuid()) @db.Uuid
  schoolId          String               @map("school_id") @db.Uuid
  academicYearId    String               @map("academic_year_id") @db.Uuid
  gradeLevelId      String               @map("grade_level_id") @db.Uuid
  name              String               @db.VarChar(100)
  code              String               @db.VarChar(20)
  capacity          Int?
  homeroomTeacherId String?              @map("homeroom_teacher_id") @db.Uuid
  status            AcademicEntityStatus @default(ACTIVE)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  gradeLevel      GradeLevel      @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  homeroomTeacher User?           @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  courseSections  CourseSection[]

  @@unique([schoolId, academicYearId, code])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([gradeLevelId])
  @@index([homeroomTeacherId])
  @@map("homeroom_classes")
}

model CourseSection {
  id                  String               @id @default(uuid()) @db.Uuid
  schoolId            String               @map("school_id") @db.Uuid
  academicYearId      String               @map("academic_year_id") @db.Uuid
  homeroomClassId     String?              @map("homeroom_class_id") @db.Uuid
  gradeLevelSubjectId String               @map("grade_level_subject_id") @db.Uuid
  name                String               @db.VarChar(100)
  code                String               @db.VarChar(30)
  status              AcademicEntityStatus @default(ACTIVE)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  homeroomClass     HomeroomClass?    @relation(fields: [homeroomClassId], references: [id], onDelete: SetNull)
  gradeLevelSubject GradeLevelSubject @relation(fields: [gradeLevelSubjectId], references: [id], onDelete: Restrict)

  @@unique([schoolId, academicYearId, code])
  @@unique([homeroomClassId, gradeLevelSubjectId])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([homeroomClassId])
  @@index([gradeLevelSubjectId])
  @@map("course_sections")
}
