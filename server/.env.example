# Server
PORT=
NODE_ENV=

# Database (Neon PostgreSQL)
DATABASE_URL=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# Cookie
COOKIE_SECURE=
COOKIE_SAME_SITE=

# CORS
CORS_ORIGIN=

# Seed (Phase 1B)
SEED_ADMIN_EMAIL=school_admin@demo.edu.vn
SEED_ADMIN_PASSWORD=SchoolAdmin@123456
SEED_SYSTEM_ADMIN_EMAIL=system_admin@demo.edu.vn
SEED_SYSTEM_ADMIN_PASSWORD=SystemAdmin@123456
SEED_DEMO_PASSWORD=
SEED_SCHOOL_CODE=
SEED_SCHOOL_NAME=
SEED_SCHOOL_TYPE=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_SIGNED_URL_EXPIRES_SEC=900
R2_MAX_FILE_SIZE_BYTES=2097152

# Import / Export (Sprint 8)
IMPORT_MAX_BYTES=5242880
IMPORT_MAX_ROWS=10000
IMPORT_DEFAULT_STUDENT_PASSWORD=Demo@123456
# Tuỳ chọn — đường dẫn Chrome/Chromium cho export PDF.
# Dev Windows/macOS: để trống, server tự tìm Chrome hệ thống hoặc bản Puppeteer đã cài.
# Production/Docker: đặt path cụ thể hoặc chạy `pnpm puppeteer:install-chrome`.
PUPPETEER_EXECUTABLE_PATH=

# Postman (optional — sync collection lên cloud)
POSTMAN_API_KEY=
