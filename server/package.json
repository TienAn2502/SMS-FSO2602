    "prisma:seed": "dotenv -e .env.development -- prisma db seed",
    "prisma:reseed-gradebook": "dotenv -e .env.development -- ts-node -O \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/scripts/reseed-gradebook.ts",
    "prisma:seed-timetable": "dotenv -e .env.development -- ts-node -O \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/scripts/seed-timetable-semester.ts",
    "prisma:seed-teaching-timetable": "dotenv -e .env.development -- ts-node -O \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/scripts/seed-teaching-timetable-semester.ts",
