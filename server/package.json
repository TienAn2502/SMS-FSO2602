    "prisma:lock-semester": "dotenv -e .env.development -- ts-node -O \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/scripts/lock-semester-gradebook.ts",
    "prisma:clear-semester": "dotenv -e .env.development -- ts-node -O \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/scripts/clear-semester-data.ts",
    "prisma:clear-semester-gradebook": "dotenv -e .env.development -- ts-node -O \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/scripts/clear-semester-gradebook-summaries.ts",
    "prisma:backfill-periods": "dotenv -e .env.development -- ts-node -O \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/scripts/backfill-periods-per-year.ts",
    "postinstall": "node scripts/postinstall.mjs",
    "puppeteer:install-chrome": "puppeteer browsers install chrome",
    "postman:export": "node scripts/sync-postman-nestjs.mjs --export-json",
    "postman:sync": "node scripts/sync-postman-nestjs.mjs"
  },
