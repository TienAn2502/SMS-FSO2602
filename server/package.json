    "generate:class-placement-hs-moi-lop-10": "dotenv -e .env.development -- ts-node -r tsconfig-paths/register -O \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/generate-new-intake-grade10-placement.ts",
    "prisma:seed-missing-homerooms": "dotenv -e .env.development -- ts-node -O \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/scripts/seed-missing-homeroom-gradebooks.ts",
