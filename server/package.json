    "prisma:seed-repair-year-summaries": "dotenv -e .env.development -- ts-node -r tsconfig-paths/register -O \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/scripts/seed-repair-year-summaries.ts",
