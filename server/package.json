    "prisma:seed-repair-hk2-summaries": "dotenv -e .env.development -- ts-node -r tsconfig-paths/register -O \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/scripts/seed-repair-hk2-summaries.ts",
